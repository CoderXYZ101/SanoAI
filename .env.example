# SanoAI — browser-only app. The deployed site's settings are in .env.production. Copy this to .env.local only to override them locally. EVERYTHING here is PUBLIC (it is bundled into the web app).
# NEVER put secret API keys here — AI keys are entered by each user in Settings and stay in their own browser.

# ── Firebase web config (Firebase console → Project settings → Your apps → Web app) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Local development against the Firebase emulators (no cloud account needed) ──
# NEXT_PUBLIC_USE_EMULATORS=true
# Throwaway account for manual testing on the LOCAL EMULATOR only (never create it on a real project):
#   e2e-owner@example.test / Emulator-Only-Pass-7

# ── Monetisation (see BILLING.md) ──
# Direct UPI payments with manual approval on the /admin page. Use YOUR real UPI ID.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=SanoAI
# Razorpay Payment Page links (UPI, cards, netbanking). Buyers must pay with their SanoAI email.
NEXT_PUBLIC_RAZORPAY_LINK_PLUS=
NEXT_PUBLIC_RAZORPAY_LINK_PRO=
NEXT_PUBLIC_RAZORPAY_LINK_PLUS_YEAR=
NEXT_PUBLIC_RAZORPAY_LINK_PRO_YEAR=
NEXT_PUBLIC_RAZORPAY_LINK_REPORT=
# URL of the managed-AI proxy worker (paid plans use SanoAI's own AI keys through it)
NEXT_PUBLIC_MANAGED_AI_URL=
# DEMO ONLY: lets anyone switch plans without paying. Leave unset in production.
# NEXT_PUBLIC_DEMO_BILLING=true
