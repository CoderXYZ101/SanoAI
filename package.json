{
  "name": "sanoai",
  "version": "1.0.0",
  "private": true,
  "description": "SanoAI — a Generative AI healthcare intelligence platform (Spark X Tech Fest, HealGen).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen-routes.mjs",
    "dev": "node scripts/gen-routes.mjs && next dev",
    "build": "node scripts/gen-routes.mjs && next build",
    "typecheck": "node scripts/gen-routes.mjs && tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-sanoai",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test:rules": "tsx scripts/test-rules.ts",
    "test:ai": "tsx scripts/test-ai-proxy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.7.0",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
